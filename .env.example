# Copy this file to .env and add your local API key. Never commit a real key.
#
# The harness reads OPENAI_API_KEY for every provider. For the OpenAI Responses
# provider (configs/run_kj.json, provider "openai") use an OpenAI (or
# Responses-compatible) key. For OpenRouter (configs/run_openrouter.json,
# provider "openrouter") paste an OpenRouter key here (starts with sk-or-v1-);
# the base URL and model slug live in that config.
OPENAI_API_KEY=

# Optional OpenRouter attribution (shown on your usage dashboard):
# OPENROUTER_HTTP_REFERER=http://localhost:8000
# OPENROUTER_X_TITLE=techjam-kuairand
