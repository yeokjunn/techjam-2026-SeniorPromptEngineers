{
  "mode": "research",
  "name": "kuairand-pure-ranking-loss-research",
  "data_dir": "data/KuaiRand-Pure/data",
  "run_root": "runs",
  "generated_root": "generated_experiments",
  "method_catalog": "research/methods",
  "official_validation_baseline": 0.6016,
  "baseline_config": "configs/baseline.json",
  "llm": {
    "provider": "openai",
    "model": "gpt-5.5",
    "reasoning_effort": "medium",
    "verbosity": "low",
    "store": false,
    "max_output_tokens": 24000,
    "max_tool_calls": 2,
    "max_total_tokens": 150000,
    "request_timeout_seconds": 180,
    "max_retries": 2
  },
  "budgets": {
    "max_iterations": 8,
    "max_wall_clock_seconds": 21600,
    "experiment_timeout_seconds": 900,
    "test_timeout_seconds": 60,
    "max_debug_repairs": 2
  },
  "convergence": {
    "epsilon": 0.002,
    "patience": 3
  },
  "replication_seeds": [1, 2]
}
